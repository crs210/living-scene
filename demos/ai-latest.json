{"question":"What worries or excites you about where AI is going?","chosen":null,"tape":[{"answers":[],"opts":{"opening":true,"final":false,"partial":false,"answers":1},"patch":{"add":[{"id":"sky","layer":0,"box":[0,0,1600,520],"at":[800,520],"enter":"fade","desc":"Dusk sky across the top, 0-520. sunset sets the sun height; drift is how fast clouds slide.","params":[{"name":"sunset","value":0.5},{"name":"drift","value":0.5}],"code":"var d = m.decay, b = m.bloom;\nvar top = k.mix('#3b3a7a', '#6a4f8f', k.clamp(m.warmth * 0.5 + 0.5, 0, 1));\nk.rect(0, 0, 1600, 300, k.mix(top, '#2a2a3a', d * 0.5));\nk.rect(0, 300, 1600, 220, k.mix('#f2a65a', '#c98a6a', d * 0.6));\nvar sy = 330 + p.sunset * 60 - b * 40;\nk.glow(1000, sy, 260 + b * 120, '#ffd88a', 0.5 + b * 0.3);\nk.blob(1000, sy, 70, 70, '#ffe7a8', {lw: 0});\nfor (var i = 0; i < 4; i++) {\n  var cx = ((t * 8 * (0.5 + p.drift) + i * 450) % 1900) - 150;\n  k.cloud(cx, 120 + i * 55, 260 + i * 40, i % 2 ? '#f6c9b0' : '#e8b4c8', {dark: d});\n}\nif (d > 0.4) { for (var j = 0; j < 8; j++) { k.dots([[j * 200, 40], [j * 200 + 90, 60]], '#15111c', 3, 9, {a: 0.3}); } }\nif (b > 0.4) { k.flock(500, 200, 160, 7, t); }"},{"id":"hills","layer":1,"box":[0,300,1600,260],"at":[800,560],"enter":"rise","desc":"Rolling green headland behind the town, y 300-560. height raises the ridge; green is how lush it is.","params":[{"name":"height","value":0.5},{"name":"green","value":0.5}],"code":"var d = m.decay, b = m.bloom;\nvar c = k.mix('#4f8a5b', '#8a7a4a', d * 0.7);\nc = k.mix(c, '#6fb86a', b * 0.5);\nvar h = 60 + p.height * 90;\nk.shape([[0,560],[0,430],[250,400 - h*0.4],[600,380 - h*0.5],[900,420 - h*0.3],[1300,360 - h*0.6],[1600,400],[1600,560]], c, {curve: true});\nk.dots([[0,480],[1600,480],[1600,560],[0,560]], '#15111c', 3, 10, {a: 0.15, fade: 'up'});\nk.stroll(200, 1400, 470, 2, t, {size: 22, coats: ['#d9c7a0'], depth: 0.6});\nif (d > 0.4) { k.hatch([[100,470],[500,450],[500,520],[100,520]], '#15111c', 12); }\nif (b > 0.4) { k.tree(1450, 450, 120, {bloom: b, flower: '#f48fb1', sway: 1, seed: 3}); }"},{"id":"sea","layer":2,"box":[0,500,1600,260],"at":[800,760],"enter":"rise","desc":"The harbour sea in front of the hills, y 500-760. depth darkens the water; swell is wave height.","params":[{"name":"depth","value":0.5},{"name":"swell","value":0.5}],"code":"var d = m.decay, b = m.bloom;\nvar c = k.mix('#2f7fa3', '#3f5a63', d * 0.7);\nc = k.mix(c, '#35b0c8', b * 0.4);\nk.wave(540, 8 + p.swell * 20 + m.storm * 30, 220, t, c, {speed: 0.8});\nk.wave(620, 10 + p.swell * 16 + m.storm * 30, 300, t, k.mix(c, '#15111c', 0.2 + p.depth * 0.3), {speed: 1.1});\nk.wave(700, 12 + p.swell * 14, 380, t, k.mix(c, '#15111c', 0.4), {speed: 0.6});\nk.glow(1000, 560, 200, '#ffd88a', 0.25 + b * 0.2);\nif (d > 0.4) { k.line([[200,660],[500,650],[800,670]], 3, '#15111c', {a: 0.4, curve: true}); }\nif (b > 0.4) { k.sparkle(900 + Math.sin(t) * 100, 590, 10, '#ffffff'); }"},{"id":"town","layer":3,"box":[120,330,760,300],"at":[500,640],"enter":"rise","desc":"A huddle of tall narrow harbour houses on the left quay, x 120-880, y 330-640. lights is how many windows glow; lean tilts the roofs.","params":[{"name":"lights","value":0.5},{"name":"lean","value":0.2}],"code":"var d = m.decay, b = m.bloom;\nvar cols = ['#e07a5f', '#f2cc8f', '#81b29a', '#9a8cc9', '#e9a6a6'];\nfor (var i = 0; i < 5; i++) {\n  var h = 180 + k.rand(i + 1) * 120;\n  var x = 190 + i * 140;\n  var lit = k.clamp(p.lights + b * 0.5 - d * 0.5, 0, 1);\n  k.building(x, 640, 120, h, cols[i], {lit: lit, boarded: d * 0.8, cracks: d, roof: i % 2 ? 'flat' : undefined, door: i % 2 === 0, seed: i});\n  k.smoke(x + 20, 640 - h, 0.4 + b * 0.4, '#d8d0e0', t + i, m.wind);\n}\nk.rope(190, 360, 760, 350, 30 + Math.sin(t) * 6, 2, '#15111c', {links: false});\nfor (var f = 0; f < 6; f++) { k.rect(230 + f * 90, 372 + Math.sin(t * 2 + f) * 3 + f % 2 * 6, 14, 20, f % 2 ? '#f7d154' : '#e0527a', {lw: 2}); }\nif (b > 0.4) { k.sparkle(500, 330 + Math.sin(t) * 10, 14, '#fff3b0'); }"},{"id":"lighthouse","layer":3,"box":[1160,170,220,480],"at":[1270,650],"enter":"rise","desc":"Striped lighthouse on a rock at the right, x 1160-1380, y 170-650. beam is the lamp's reach; lean tilts the tower.","params":[{"name":"beam","value":0.5},{"name":"lean","value":0}],"code":"var d = m.decay, b = m.bloom;\nvar tilt = p.lean * 40 + d * 14;\nk.shape([[1160,650],[1200,600],[1340,600],[1390,650]], '#6b6470');\nvar lx = 1270 + tilt;\nk.shape([[1220,610],[1320,610],[lx + 35,260],[lx - 35,260]], '#fbf6e9');\nk.shape([[1213,520],[1327,520],[1317,460],[1223,460]], '#d94f4f', {lw: 0});\nk.shape([[1230,410],[1310,410],[lx + 45,340],[lx - 45,340]], '#d94f4f', {lw: 0});\nk.rect(lx - 45, 230, 90, 40, '#2a2a3a');\nvar a = t * 0.8;\nk.glow(lx, 215, 90 + p.beam * 90 + b * 60, '#fff3b0', 0.5 + 0.4 * Math.sin(a));\nk.shape([[lx, 215], [lx - 500 * Math.cos(a), 160], [lx - 500 * Math.cos(a), 270]], '#fff3b0', {lw: 0, a: 0.15 + p.beam * 0.2 + b * 0.15});\nk.shape([[lx - 50, 230], [lx + 50, 230], [lx, 175]], d > 0.5 ? '#4a3a3a' : '#d94f4f');\nif (d > 0.4) { k.crack(1270, 560, 80, 4); }\nk.flock(1270, 130, 120, 4, t);"},{"id":"boats","layer":4,"box":[250,610,1000,130],"at":[700,740],"enter":"slide","desc":"Small sailing boats crossing the harbour, x 250-1250, y 610-740. fleet is how many; sail is how full the sails are.","params":[{"name":"fleet","value":0.5},{"name":"sail","value":0.5}],"code":"var d = m.decay, b = m.bloom;\nvar n = 2 + Math.floor(p.fleet * 2 + b * 2);\nfor (var i = 0; i < n; i++) {\n  var x = ((t * (14 + i * 6) + i * 300) % 1100) + 200;\n  var y = 700 + Math.sin(t * 1.3 + i) * 6 + i * 6;\n  k.shape([[x - 60, y], [x + 60, y], [x + 40, y + 24], [x - 40, y + 24]], '#8a5a3a');\n  k.line([[x, y], [x, y - 100]], 5, '#15111c');\n  var s = 40 + p.sail * 30 + m.wind * 20;\n  k.shape([[x + 6, y - 96], [x + 6 + s, y - 20], [x + 6, y - 20]], d > 0.5 ? '#bdb09a' : '#fbf6e9', {curve: false});\n  k.shape([[x - 6, y - 90], [x - 6 - s * 0.6, y - 24], [x - 6, y - 24]], i % 2 ? '#f2cc8f' : '#e0527a');\n}\nif (d > 0.5) { k.scribble(300, 650, 60, 30, '#15111c', 5); }"},{"id":"walkers","layer":6,"box":[60,690,1480,190],"at":[800,880],"enter":"fade","desc":"People strolling along the foreground quay, x 60-1540, y 690-880. crowd sets how many; hats are their number of silly hats.","params":[{"name":"crowd","value":0.5},{"name":"hats","value":0}],"code":"var d = m.decay, b = m.bloom;\nk.rect(0, 820, 1600, 80, k.mix('#c8b79a', '#8a8070', d * 0.6), {lw: 3});\nk.dots([[0, 850], [1600, 850], [1600, 900], [0, 900]], '#15111c', 3, 9, {a: 0.2});\nvar n = 4 + Math.floor(p.crowd * 6 + m.bond * 4);\nk.stroll(80, 1520, 840, n, t, {size: 110, coats: ['#e07a5f', '#3d405b', '#81b29a', '#f2cc8f', '#9a8cc9'], speed: 1, hat: p.hats > 0.5, arms: b, depth: 0.5});\nk.stroll(100, 1500, 800, 3, t + 7, {size: 80, coats: ['#3d405b', '#e9a6a6'], speed: 0.7, depth: 0.3});\nif (b > 0.4) { k.tree(40, 830, 140, {bloom: b, flower: '#f48fb1', sway: 1, seed: 8}); }\nif (d > 0.4) { k.boards(1480, 770, 90, 60); }"}],"note":"A dusk harbour town where lamplight, boats and strollers go quietly about their evening, waiting to be changed."}},{"answers":["there will be data centres everywhere","bring back the dinosaurs","I think it will make life better honestly","jobs will disappear"],"opts":{"opening":false,"final":false,"partial":false,"answers":4},"patch":{"feelings":{"hope":0.4,"dread":0.5,"wonder":0.5,"anger":0.1,"grief":0.2,"belonging":0.1,"agency":0.1,"unease":0.4,"urgency":0.3},"ideas":[{"theme":"data-centres","n":1,"gist":"data centres everywhere","touches":["hills","town"]},{"theme":"dinosaurs","n":1,"gist":"bring back dinosaurs","touches":["dino","hills"]},{"theme":"life-better","n":1,"gist":"AI makes life better","touches":["town"]},{"theme":"jobs","n":1,"gist":"jobs will disappear","touches":["walkers"]}],"set":[{"id":"sea","params":[{"name":"swell","value":0.7}]},{"id":"boats","params":[{"name":"fleet","value":0.3}]}],"add":[{"id":"walkers","theme":"jobs","layer":6,"box":[60,690,1480,190],"at":[800,880],"enter":"fade","desc":"Foreground quay x 60-1540, y 690-880. Fewer strollers; empty coats hang on hooks and empty chairs sit at desks. crowd thins, hats unused.","params":[{"name":"crowd","value":0.2},{"name":"hats","value":0}],"code":"var d = m.decay, b = m.bloom;\nk.rect(0, 820, 1600, 80, k.mix('#c8b79a', '#8a8070', d * 0.6), {lw: 3});\nk.dots([[0, 850], [1600, 850], [1600, 900], [0, 900]], '#15111c', 3, 9, {a: 0.2});\nvar n = 2 + Math.floor(p.crowd * 4 + m.bond * 3);\nk.stroll(80, 1520, 840, n, t, {size: 110, coats: ['#e07a5f', '#3d405b', '#81b29a'], speed: 1.2, arms: b, depth: 0.5, hat: b > 0.5});\nvar e = 3 + Math.floor(p.w * 4);\nfor (var i = 0; i < e; i++) {\n  var x = 200 + i * 200;\n  k.rect(x, 790, 40, 6, '#15111c', {lw: 0});\n  k.line([[x + 4, 796], [x + 4, 830]], 4, '#15111c');\n  k.line([[x + 36, 796], [x + 36, 830]], 4, '#15111c');\n  k.shape([[x - 6, 790], [x + 46, 790], [x + 46, 740], [x - 6, 740]], '#3d405b', {lw: 3});\n  k.shape([[x + 10, 735], [x + 30, 735], [x + 36 + Math.sin(t * 0.8 + i) * 8, 700], [x + 4, 700]], i % 2 ? '#e07a5f' : '#f2cc8f', {curve: true});\n  if (Math.sin(t * 0.3 + i * 2) > 0.9) { k.sparkle(x + 20, 690, 8, '#ffffff'); }\n}\nif (d > 0.4) { k.boards(1480, 770, 90, 60); }"},{"id":"town","theme":"life-better","layer":3,"box":[120,330,760,260],"at":[500,600],"enter":"grow","desc":"Harbour houses x 120-880, y 330-600, pulled up the quay clear of the water. Roof gardens and lit windows; power cables run up to the data centres on the hill. lights = glow.","params":[{"name":"lights","value":0.9},{"name":"lean","value":0.1}],"code":"var d = m.decay, b = m.bloom;\nvar cols = ['#f2a65a', '#f2cc8f', '#81b29a', '#b6a6e0', '#f4b6b6'];\nfor (var i = 0; i < 5; i++) {\n  var h = 160 + k.rand(i + 1) * 100;\n  var x = 190 + i * 140;\n  var lit = k.clamp(p.lights + b * 0.3 - d * 0.5, 0, 1);\n  k.building(x, 600, 120, h, cols[i], {lit: lit, boarded: d * 0.8, cracks: d, door: i % 2 === 0, seed: i});\n  k.tree(x, 600 - h, 40 + p.