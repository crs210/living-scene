, t + i, m.wind);\n}\nk.stroll(200, 1400, 470, 1, t, {size: 22, coats: ['#d9c7a0'], depth: 0.6});\nif (d > 0.4) { k.hatch([[100,470],[500,450],[500,520],[100,520]], '#15111c', 12); }"},{"id":"dino","theme":"dinosaurs","layer":2,"box":[480,230,560,420],"at":[760,650],"enter":"rise","desc":"A long-necked dinosaur wading in the harbour, x 480-1040, y 230-650, between town and lighthouse; head nibbles the rooftop gardens, a server rack of blinking lights strapped on its back.","params":[{"name":"size","value":0.8}],"code":"var d = m.decay, b = m.bloom;\nvar s = 0.6 + p.w * 0.5;\nvar x = 760, y = 640;\nvar sw = Math.sin(t * 0.7) * 20;\nvar col = k.mix('#7fae5a', '#8a8a5a', d * 0.5);\nk.blob(x, y - 80 * s, 180 * s, 80 * s, col);\nk.line([[x - 140 * s, y - 80 * s], [x - 220 * s, y - 40 * s], [x - 280 * s, y - 20 * s]], 22 * s, col, {curve: true});\nk.line([[x + 100 * s, y - 100 * s], [x + 150 * s + sw, y - 220 * s], [x + 60 * s + sw, y - 360 * s], [x - 60 * s + sw * 1.5, y - 410 * s + Math.sin(t * 1.2) * 20]], 36 * s, col, {curve: true});\nk.blob(x - 80 * s + sw * 1.5, y - 410 * s + Math.sin(t * 1.2) * 20, 42 * s, 26 * s, col);\nk.eye(x - 90 * s + sw * 1.5, y - 420 * s + Math.sin(t * 1.2) * 20, 8 * s, {look: [-1, 1], lid: Math.sin(t * 0.3) > 0.9 ? 1 : 0});\nfor (var l = 0; l < 4; l++) { k.rect(x - 130 * s + l * 80 * s, y - 60 * s, 30 * s, 60 * s + (l % 2) * 6, col, {lw: 4}); }\nk.rect(x - 70 * s, y - 190 * s, 130 * s, 60 * s, '#3a3844');\nfor (var r = 0; r < 3; r++) { for (var q = 0; q < 6; q++) { if (Math.sin(t * 3 + r + q * 2) > -0.2) { k.rect(x - 62 * s + q * 20 * s, y - 182 * s + r * 17 * s, 10 * s, 6 * s, '#7ee0a0', {lw: 0}); } } }\nif (d > 0.4) { k.crack(x, y - 100 * s, 60, 6); }\nif (b > 0.4) { k.sparkle(x - 130 * s + sw, y - 440 * s, 10, '#fff3b0'); }"}],"note":"Server halls swallow the hillside while a dinosaur wades in with a rack on its back, the town glows with hope, and empty chairs wait on the quay."}},{"answers":["everyone should get funny hats","more data c