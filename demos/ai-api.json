40, 820, 990];\nvar ry = [505, 465, 525];\nfor (var c = 0; c < 3; c++) {\n  var sx = 1180, sy = 330 + c * 20;\n  k.rope(sx, sy, rx[c], ry[c], 60 + sw * 5, 8, '#15111c', {links: false});\n  k.rope(sx, sy, rx[c], ry[c], 60 + sw * 5, 3, '#7df9ff', {links: false});\n  for (var n = 0; n < 3; n++) {\n    var u = (t * 0.5 + n / 3 + c * 0.2) % 1;\n    k.glow(k.lerp(sx, rx[c], u), k.lerp(sy, ry[c], u) + Math.sin(u * 3.14) * 60, 12, '#fff3a0', 0.9);\n  }\n}\nvar ax = [700, 790, 880, 960];\nfor (var j = 0; j < 4; j++) {\n  var ty = 250 - j * 12 - w * 30;\n  k.line([[ax[j], 330 - j * 10], [ax[j] + sw * 3, ty]], 3, '#15111c');\n  if (Math.sin(t * 3 + j * 2) > 0) { k.glow(ax[j] + sw * 3, ty, 14, '#f4c542', 0.8); }\n}\nk.smoke(990, 430, 0.5 + sw * 0.1 + d * 0.4, '#ddd', t, m.wind);\nif (d > 0.4) { k.scribble(600, 500, 100, 60, '#15111c', 5); k.crack(820, 600, 60, 4); }\nif (b > 0.4) { k.sparkle(820 + Math.sin(t) * 80, 300, 8, '#f4c542'); k.sparkle(700 + Math.cos(t) * 60, 380, 6, '#fff'); }","params":[{"name":"change","value":0.9}]}]}},{"answers":[],"opts":{"opening":false,"final":false,"partial":true,"answers":1},"patch":{"add":[{"id":"oak","theme":"dinosaurs","layer":3,"box":[1000,200,600,440],"at":[1330,640],"enter":"grow","desc":"Oak at x1330 with a giant sauropod behind, plus a necklace-wearing stegosaur, a small raptor peering left at the data centres, and a baby dino. Decay strips leaves; bloom adds blossom and sparkles.","code":"var d = m.decay, b = m.bloom;\nvar br = Math.sin(t * 0.8) * 4;\nvar sw = Math.sin(t * 0.7);\nvar skin = k.mix('#7fb36a', '#8a8f6a', d);\nvar skin2 = k.mix('#e0a458', '#a89466', d);\nk.shape([[1180,640],[1190,540],[1240,480],[1320,470],[1400,490],[1450,560],[1460,640],[1420,640],[1405,580],[1370,640],[1330,640],[1290,590],[1250,640]], skin, {curve: true});\nk.line([[1250,500],[1230,420],[1250,340],[1290,290 + br],[1340,270 + br]], 34, skin, {curve: true});\nk.blob(1355, 268 + br, 34, 22, skin);\nk.blob(1362, 262 + br, 4, 4, '#15111c', {lw: 0});\nk.line([[1440,560],[1500,590 + sw * 10],[1560,570 + sw * 25],[1600,540 + sw * 40]], 26, skin, {curve: true});\nk.dots([[1250,480],[1450,490],[1450,600],[1250,600]], '#4f7a4a', 5, 12, {a: 0.5});\nk.tree(1330, 640, 340, {bare: d, bloom: b, leaf: '#4f9d4f', flower: '#f4a6c0', sway: 0.4 + m.wind, seed: 3});\nif (d > 0.5) { k.crack(1330, 640, 60, 4); }\nvar sb = Math.sin(t * 1.2) * 3;\nk.shape([[1030,640],[1040,590 + sb],[1100,560 + sb],[1170,570 + sb],[1210,610],[1210,640]], skin2, {curve: true});\nfor (var i = 0; i < 5; i++) { k.shape([[1060 + i * 28,580 + sb],[1074 + i * 28,540 + sb - (i % 2) * 8],[1088 + i * 28,574 + sb]], '#d9534f'); }\nk.line([[1030,600],[1000,590 + sw * 6],[975,610]], 16, skin2, {curve: true});\nk.blob(1200, 612, 18, 13, skin2);\nk.blob(1206, 608, 3, 3, '#15111c', {lw: 0});\nk.rope(1175, 585 + sb, 1215, 595, 22, 4, '#15111c', {links: true});\nk.glow(1195, 612, 14 + Math.sin(t * 4) * 3, '#ffd23f', 0.7);\nvar rh = Math.sin(t * 0.5) * 5;\nk.shape([[1080,640],[1085,610],[1115,595 + rh],[1135,640]], '#6a7fd1', {curve: true});\nk.line([[1105,600 + rh],[1085,565 + rh],[1060,560 + rh]], 10, '#6a7fd1', {curve: true});\nk.blob(1055, 559 + rh, 14, 9, '#6a7fd1');\nk.eye(1052, 556 + rh, 5, {look: [-1, 0], lid: Math.sin(t * 0.3) > 0.9 ? 1 : 0});\nk.blob(1260 + sw * 5, 630, 22, 14 + br, '#f08fb0');\nk.blob(1245 + sw * 5, 622, 3, 3, '#15111c', {lw: 0});\nfor (var q = 0; q < 4; q++) {\n  var fy = 300 + ((t * 20 + q * 40) % 120);\n  if (d < 0.8) { k.blob(1320 + q * 12, fy, 4, 3, '#4f9d4f', {lw: 0, a: 0.8 - (fy - 300) / 150}); }\n}\nif (b > 0.4) { for (var j = 0; j < 5; j++) { k.sparkle(1230 + j * 40, 400 + Math.sin(t + j) * 6, 6, '#f4a6c0'); } }\nk.flock(1250, 230 + Math.sin(t) * 10, 120, 5, t);","params":[]}]}},{"answers":[],"opts":{"opening":false,"final":false,"partial":true,"answers":1},"patch":{"add":[{"id":"hills","theme":"data-centres","layer":0,"box":[0,0,1600,640],"at":[800,640],"enter":"rise","desc":"Colossal windowless data-centre slab stack behind the town, y0-640, tiers floating and merging, vents pulsing, glowing pylons down its slopes. slabs = size, thirst = river drained.","code":"var d = m.decay, b = m.bloom;\nvar w = k.clamp(p.w || 0.2, 0, 1);\nvar th = k.clamp(p.thirst || 0.5, 0, 1);\nk.wave(470, 22, 520, t, k.mix('#7fb069', '#8a8a5a', d), {speed: 0.1});\nvar sl = k.clamp(p.slabs || 0.9, 0, 1.2);\nvar xs = [60, 330, 640, 960, 1260, 1520];\nfor (var i = 0; i < 6; i++) {\n  var s = 1 + sl * 0.9 + w * 0.6 + k.rand(i) * 0.3;\n  var bw = 300 * s * 0.6, bh = 200 * s * 0.75 + 120 * w;\n  var gx = xs[i], gy = 500 + k.rand(i + 9) * 40;\n  k.building(gx, gy, bw, bh, k.mix('#6d717a', '#4b4e55', d), {lit: 0, boarded: 0, cracks: d, roof: 'flat', seed: i});\n  k.rect(gx - bw * 0.5, gy - bh * 0.6, bw, 8, '#3d4048');\n  var fy = gy - bh - 40 - Math.sin(t * 0.5 + i) * 10;\n  var fw = bw * (0.7 + 0.2 * Math.sin(i + t * 0.2));\n  k.rect(gx - fw / 2 + Math.sin(t * 0.3 + i) * 15, fy - 50, fw, 50, '#5a5d66');\n  k.rect(gx - fw / 2 + Math.sin(t * 0.3 + i) * 15, fy - 54, fw, 6, '#3d4048');\n  k.rect(gx - 8, gy - bh, 16, 40 + Math.sin(t + i) * 4, '#4d5058', {lw: 0});\n  for (var j = 0; j < 5; j++) {\n    var on = Math.sin(t * 3 + i * 2 + j * 1.7) > -0.2;\n    k.blob(gx - bw * 0.3 + j * bw * 0.15, gy - bh * 0.3, 5, 5, on ? '#5df28a' : '#2a5a3a', {lw: 0});\n  }\n  var pu = 0.5 + 0.5 * Math.sin(t * 2 + i);\n  k.glow(gx, gy - bh * 0.7, 40 + pu * 25, '#5df28a', 0.25 + pu * 0.25);\n  k.smoke(gx + bw * 0.3, gy - bh, 0.4 + w * 0.4, '#9a9ea6', t, m.wind);\n  if (b > 0.3) { k.rect(gx - bw / 2, gy - bh - 8, bw, 10, '#5e9c5a'); k.sparkle(gx, gy - bh - 16, 5, '#f4c542'); }\n  if (d > 0.4) { k.fence(gx - bw * 0.6, gy + 6, gx + bw * 0.6, 28, '#3a3a40', {gap: 18, broken: d}); }\n  var tx = 800 + (gx - 800) * 0.3;\n  var ry = 585;\n  k.rope(gx, gy - 20, gx, ry, 10, 14, '#6b6e75');\n  k.rope(gx, gy, tx, 600, 24, 8, '#8a8e96');\n  var u = (t * 0.5 + i * 0.17) % 1;\n  k.blob(gx + Math.sin(u * 6) * 2, k.lerp(ry, gy - 20, u), 6, 8, '#4aa8e8', {lw: 0, a: 0.85});\n  k.blob(k.lerp(gx, tx, u), k.lerp(gy, 600, u) + 10, 5, 5, '#5df28a', {lw: 0, a: 0.8});\n}\nfor (var n = 0; n < 9; n++) {\n  var px = 100 + n * 175, py = 520 + (n % 3) * 30, ph = 90 + (n % 2) * 20;\n  k.line([[px, py], [px, py - ph]], 5, '#2a2a33');\n  k.line([[px - 28, py - ph + 14], [px + 28, py - ph + 14]], 4, '#2a2a33');\n  if (n < 8) {\n    k.line([[px + 28, py - ph + 14], [px + 147, 520 + ((n + 1) % 3) * 30 - 90 - (((n + 1) % 2) * 20) + 14]], 3, '#5df2e8', {curve: true, a: 0.8});\n  }\n  var q = 0.5 + 0.5 * Math.sin(t * 4 - n);\n  k.glow(px, py - ph + 14, 14 + q * 10, '#5df2e8', 0.5 + q * 0.4);\n}\nvar rw = 1 - th;\nk.wave(610 + th * 30, 6 * rw + 1, 260, t, '#4aa8e8', {speed: 0.6});\nk.rect(0, 628, 1600, 14, '#6b5a40', {lw: 0});\nfor (var c = 0; c < 10; c++) { k.crack(80 + c * 160, 632, 40 + th * 60, c); }\nif (d > 0.4) { for (var q2 = 0; q2 < 6; q2++) { k.scribble(100 + q2 * 260, 610, 60, 20, '#5a4a3a', q2); } }\nif (b > 0.3) { for (var r = 0; r < 12; r++) { k.sparkle(80 + r * 130, 560 + k.rand(r) * 60, 5 + Math.sin(t * 2 + r) * 2, '#f4c542'); } }","params":[{"name":"slabs","value":1.2},{"name":"thirst","value":0.9}]}]}}]}