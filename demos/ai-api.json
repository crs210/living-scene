ers":[],"opts":{"opening":false,"final":false,"partial":true,"answers":1},"patch":{"add":[{"id":"hills","theme":"data-centres","layer":0,"box":[0,380,1600,260],"at":[800,640],"enter":"rise","desc":"Green ridge y380-640 across the frame, now studded with grey windowless data-centre slabs and pipes down to the town. p.w enlarges slabs; decay greys and fences; bloom plants roofs.","code":"var d = m.decay, b = m.bloom;\nvar w = k.clamp(p.w || 0.2, 0, 1);\nk.wave(470, 22, 520, t, k.mix('#7fb069', '#8a8a5a', d), {speed: 0.1});\nk.wave(540, 16, 380, t, k.mix('#5e9c5a', '#6e6a48', d), {speed: 0.2});\nvar xs = [150, 420, 1050, 1300, 1500];\nfor (var i = 0; i < 5; i++) {\n  var s = 0.7 + w * 0.6 + k.rand(i) * 0.3;\n  var bw = 170 * s, bh = 110 * s;\n  var gx = xs[i], gy = 520 + k.rand(i + 9) * 70;\n  k.building(gx, gy, bw, bh, k.mix('#8d919a', '#6b6e75', d), {lit: 0, boarded: 0, cracks: d, roof: 'flat', seed: i});\n  k.rect(gx - bw * 0.45, gy - bh * 0.7, bw * 0.9, 6, '#5d6068');\n  for (var j = 0; j < 4; j++) {\n    var on = Math.sin(t * 3 + i * 2 + j * 1.7) > -0.2;\n    k.blob(gx - bw * 0.3 + j * bw * 0.2, gy - bh * 0.3, 4, 4, on ? '#5df28a' : '#2a5a3a', {lw: 0});\n  }\n  if (b > 0.3) {\n    k.rect(gx - bw / 2, gy - bh - 8, bw, 10, '#5e9c5a');\n    k.sparkle(gx - bw * 0.2 + Math.sin(t + i) * 3, gy - bh - 14, 5, '#f4c542');\n    k.sparkle(gx + bw * 0.25, gy - bh - 14, 4, '#f48fb1');\n  }\n  if (d > 0.4) { k.fence(gx - bw * 0.6, gy + 6, gx + bw * 0.6, 28, '#3a3a40', {gap: 18, broken: d}); }\n  var tx = 800 + (gx - 800) * 0.35;\n  k.rope(gx, gy, tx, 600, 24, 6, '#6b6e75');\n  var u = (t * 0.4 + i * 0.2) % 1;\n  k.blob(k.lerp(gx, tx, u), k.lerp(gy, 600, u) + 10, 4, 4, '#5df28a', {lw: 0, a: 0.8});\n}\nif (d > 0.4) { for (var q = 0; q < 6; q++) { k.scribble(100 + q * 260, 610, 60, 20, '#5a4a3a', q); } }\nif (b > 0.3) { for (var r = 0; r < 12; r++) { k.sparkle(80 + r * 130, 560 + k.rand(r) * 60, 5 + Math.sin(t * 2 + r) * 2, '#f4c542'); } }","params":[]}]}},{"answers":[],"opts":{"opening":false,"final":false,"partial":true,"answers":1},"patch":{"add":[{"id":"sun","theme":"life-better","layer":0,"box":[1000,-60,500,500],"at":[1250,190],"enter":"grow","desc":"Huge idealised golden sun at 1250,190 with rotating rays and a circuit halo, lighting the town. Scale follows p.w; bloom adds glow and sparkles, decay dims and reddens it.","code":"var d = m.decay, b = m.bloom;\nvar w = p.w || 0.3;\nvar s = 1.1 + w * 0.7;\nvar cx = 1250, cy = 190;\nvar col = k.mix('#ffd166', '#c9573a', d);\nk.glow(cx, cy, (230 + b * 90) * s, col, 0.35 + b * 0.3 - d * 0.15);\nk.glow(cx, cy, 130 * s, '#fff1b8', 0.45 * (1 - d * 0.5));\nfor (var i = 0; i < 16; i++) {\n var a = i * 0.3927 + t * 0.12;\n var r1 = 100 * s, r2 = (150 + (i % 2) * 40 + b * 30 + Math.sin(t * 1.5 + i) * 8) * s;\n k.line([[cx + Math.cos(a) * r1, cy + Math.sin(a) * r1], [cx + Math.cos(a) * r2, cy + Math.sin(a) * r2]], i % 2 ? 4 : 7, i % 2 ? '#15111c' : col, {a: 1 - d * 0.4});\n}\nfor (var j = 0; j < 12; j++) {\n var a2 = j * 0.5236 - t * 0.15;\n var rr = 125 * s;\n var x1 = cx + Math.cos(a2) * rr, y1 = cy + Math.sin(a2) * rr;\n var x2 = cx + Math.cos(a2 + 0.26) * rr, y2 = cy + Math.sin(a2 + 0.26) * rr;\n var x3 = cx + Math.cos(a2 + 0.26) * (rr + 22 * s), y3 = cy + Math.sin(a2 + 0.26) * (rr + 22 * s);\n k.line([[x1, y1], [x2, y2], [x3, y3]], 3, '#ffb347', {a: 0.8 - d * 0.4});\n k.blob(x3, y3, 5, 5, '#fff1b8', {lw: 2, a: 0.5 + 0.5 * Math.sin(t * 3 + j)});\n}\nk.blob(cx, cy, 85 * s, 85 * s, col, {lw: 5});\nk.blob(cx - 18, cy - 20, 40 * s, 32 * s, '#fff1b8', {lw: 0, a: 0.6 * (1 - d)});\nif (d > 0.3) { k.hatch([[cx - 70, cy + 20], [cx + 70, cy + 20], [cx + 50, cy + 70], [cx - 50, cy + 70]], '#8a3a2a', 10); }\nif (b > 0.3) { for (var q = 0; q < 6; q++) { k.sparkle(cx + Math.cos(q * 1.05 + t * 0.5) * 190 * s, cy + Math.sin(q * 1.05 + t * 0.5) * 170 * s, 8 + Math.sin(t * 2 + q) * 3, '#fff1b8'); } }\nk.cloud(900 + (t * 8) % 300, 120, 220, '#fbf6e9', {dark: d});","params":[]}]}},{"answers":[],"opts":{"opening":fals