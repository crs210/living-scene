# Copy this file to .env (which git ignores) and fill it in. Never commit a real key.
# With a key set, the app directs itself through the Claude API. Without one, the recorded demo still plays.
ANTHROPIC_API_KEY=

# The model that reads the room, and the one that writes the drawings (defaults: Opus 5.5 directs, Sonnet 5.5 draws).
# DIRECTOR_MODEL=claude-opus-5-5
# DRAW_MODEL=claude-sonnet-5-5

# Requests to the model per session before the app stops calling it (default 500).
# MAX_API_CALLS=500

# Only when the app is hosted somewhere other than the computer showing the display:
# a long random value; open the display as /comic?key=<this value> to use the host controls.
# HOST_KEY=
# PUBLIC_URL=https://your-address.example/
